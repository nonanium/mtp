{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "mtp/raw": ["src/raw/index.ts"],
      "mtp/type-map": ["src/type-map/index.ts"]
    },
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/raw/**/*.ts",
    "src/sdk/**/*.ts",
    "src/type-map/**/*.ts",
    "src/vite/**/*.ts"
  ]
}
